# Copy to .env (install.sh does this for you and generates SECRET_KEY).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SITE_URL=https://example.com
COOKIE_SECURE=1
DATA_DIR=/opt/amxme/data
UPLOAD_DIR=/opt/amxme/data/uploads

# Email for the contact form (optional). After editing: sudo systemctl restart amxme
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
